# Desarrollo local: SQLite, no requiere cuenta externa.
# Producción (Vercel): cambiar el provider en prisma/schema.prisma a "postgresql"
# y usar una URL de Neon/Supabase/Railway aquí.
DATABASE_URL="file:./dev.db"

# Auth.js — genera uno con: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3002"

# Resend (magic link por email) — https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Cloudflare Workers AI (mascota, fondos y avatares generados con IA, opcional)
# — free tier sin tarjeta. Sin esto, la app usa el fallback dibujado en código
# (fondo animado CSS/SVG, mascota SVG, avatares con emoji).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_IMAGE_MODEL="@cf/stabilityai/stable-diffusion-xl-base-1.0"
